{
  "name": "catanatron-colonist-desktop",
  "version": "0.7.1",
  "description": "A security-hardened Colonist desktop browser with immersive, local game-state intelligence.",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "assets": "node scripts/generate-icons.cjs",
    "archive:mac": "node scripts/archive-mac.cjs",
    "archive:win": "node scripts/archive-windows.cjs",
    "build": "node scripts/build.cjs",
    "start": "npm run build && electron .",
    "start:demo": "npm run build && CATANATRON_TRACKER_DEMO=1 electron .",
    "test": "node --test tests/*.test.cjs",
    "verify:build": "node scripts/verify-build.cjs",
    "check": "npm run assets && npm run build && npm test && npm run verify:build",
    "package:mac": "npm run check && node scripts/package-mac.cjs",
    "package:mac:dmg": "npm run package:mac && node scripts/create-mac-dmg.cjs",
    "package:win": "npm run check && node scripts/package-win.cjs --arch=x64",
    "package:win:installer": "npm run package:win && npm run installer:win && npm run verify:win:installer",
    "package:win:arm64": "npm run check && node scripts/package-win.cjs --arch=arm64",
    "installer:win": "electron-builder --prepackaged \"release/Catanatron Colonist-win32-x64\" --win nsis --x64 --publish never",
    "verify:win": "node scripts/verify-windows-package.cjs",
    "verify:win:installer": "node scripts/verify-windows-installer.cjs",
    "smoke:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows.ps1",
    "smoke:win:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-installer.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electron/packager": "20.2.0",
    "@electron/fuses": "2.1.3",
    "@msgpack/msgpack": "3.1.3",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "resedit": "3.0.2"
  },
  "build": {
    "appId": "dev.pranavg.catanatron.colonist",
    "productName": "Catanatron Colonist",
    "directories": {
      "buildResources": "assets",
      "output": "release/installer"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Catanatron-Colonist-${version}-Windows-${arch}-Setup.${ext}"
    }
  }
}
