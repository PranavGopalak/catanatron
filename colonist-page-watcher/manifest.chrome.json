{
  "manifest_version": 3,
  "name": "Colonist Page Watcher",
  "version": "0.1.9",
  "description": "Tracks Colonist game events and cards locally in an automatic browser extension dashboard.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://colonist.io/*", "https://*.colonist.io/*"],
  "content_scripts": [{
    "matches": ["https://colonist.io/*", "https://*.colonist.io/*"],
    "js": ["src/core.js", "src/ws-core.js", "src/content.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_title": "Colonist Watcher",
    "default_popup": "src/popup.html",
    "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}
  },
  "web_accessible_resources": [{
    "resources": ["src/page-websocket-hook.js", "src/ws-core.js"],
    "matches": ["https://colonist.io/*", "https://*.colonist.io/*"]
  }],
  "background": {"service_worker": "src/background.js"},
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  }
}
